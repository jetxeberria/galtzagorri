[project]
name = "{% include 'name-slug.jinja' %}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [
    {name = "jetxeberria", email = "etxeberria_92@hotmail.com"},
]
requires-python = ">={{ python_min }}"
readme = "README.md"
license = {text = "MIT"}

# Runtime dependencies: owned by the project (`just add <package>`)
dependencies = []

[dependency-groups]
# Owned by the galtzagorri template: tools its recipes need, as minimum versions.
# `just update` merges template changes here; do not edit these lines. To need a
# newer version of one of them, add a higher floor to the `dev` group instead.
base = [
    "copier>=9.4",
    "pre-commit>=4.7",
    "pytest>=8.3",
    "ruff>=0.12",
    "yamllint>=1.35",
]

# Development dependencies: owned by the project (`just add -dG dev <package>`)
dev = []

# Every project is a package (galtzagorri PKG-2): `just build`, then
# `just install-tool` or `just install-tool-editable` put [project.scripts] on PATH
[build-system]
requires = ["pdm-backend>=2.5"]
build-backend = "pdm.backend"

[tool.pdm]
distribution = true
plugins = ["pdm-bump"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP"]
