[project]
name = "{% include 'name-slug.jinja' %}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [
    {name = "jetxeberria", email = "etxeberria_92@hotmail.com"},
]
dependencies = []
requires-python = "==3.12.*"
readme = "README.md"
license = {text = "MIT"}

[dependency-groups]
dev = [
    "copier>=9.4",
    "pytest>=8.3",
    "ruff>=0.12",
    "yamllint>=1.35",
]

[tool.pdm]
distribution = false
plugins = ["pdm-bump"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP"]
